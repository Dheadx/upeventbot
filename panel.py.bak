from flask import Flask, request, redirect, url_for, render_template_string
import sqlite3
import os
import asyncio
from datetime import datetime
from zoneinfo import ZoneInfo
from telegram import Bot

app = Flask(__name__)

DB = "aff_posts.db"
TZ = ZoneInfo("Europe/Istanbul")

# Yeni BotFather tokenını Terminal'de tanımlayacağız.
TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "")

HTML = """
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>UltraPari AFF Panel</title>
<style>
body{margin:0;background:#0f172a;color:#fff;font-family:Arial}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:210px;background:#08111f;padding:25px}
.sidebar h2{margin-bottom:40px}
.sidebar a{display:block;color:#fff;text-decoration:none;padding:15px 10px;border-radius:8px}
.sidebar a:hover{background:#1e293b}
.main{margin-left:210px;padding:45px}
.card{display:inline-block;background:#1e293b;padding:25px;border-radius:12px;margin-right:15px;min-width:180px}
.number{font-size:32px;font-weight:bold;margin-top:10px}
button,.btn{background:#2563eb;color:white;border:0;border-radius:7px;padding:11px 18px;cursor:pointer;text-decoration:none}
input,textarea,select{width:100%;box-sizing:border-box;background:#1e293b;color:white;border:1px solid #475569;border-radius:7px;padding:12px;margin:7px 0 18px}
textarea{height:180px}
.box{background:#1e293b;padding:25px;border-radius:12px;max-width:800px}
table{width:100%;border-collapse:collapse;margin-top:20px}
td,th{padding:12px;border-bottom:1px solid #334155;text-align:left}
.ok{background:#14532d;padding:12px;border-radius:7px;margin-bottom:20px}
.err{background:#7f1d1d;padding:12px;border-radius:7px;margin-bottom:20px}
</style>
</head>
<body>

<div class="sidebar">
<h2>⚡ UltraPari</h2>
<a href="/">📊 Dashboard</a>
<a href="/groups">👥 Gruplar</a>
<a href="/new">➕ Yeni Post</a>
<a href="/planned">📅 Planlananlar</a>
<a href="/sent">📤 Gönderilenler</a>
<a href="/settings">⚙️ Ayarlar</a>
</div>

<div class="main">
{% block content %}{% endblock %}
</div>

</body>
</html>
"""

def db():
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = db()

    conn.execute("""
    CREATE TABLE IF NOT EXISTS groups (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        chat_id TEXT UNIQUE NOT NULL,
        name TEXT NOT NULL
    )
    """)

    conn.execute("""
    CREATE TABLE IF NOT EXISTS posts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        group_id INTEGER NOT NULL,
        text TEXT NOT NULL,
        send_at TEXT NOT NULL,
        status TEXT DEFAULT 'planned',
        sent_at TEXT
    )
    """)

    conn.commit()
    conn.close()

def telegram_send(chat_id, text):
    if not TOKEN:
        raise Exception("TELEGRAM_BOT_TOKEN ayarlanmamış.")

    async def send():
        bot = Bot(TOKEN)
        await bot.send_message(chat_id=chat_id, text=text)

    asyncio.run(send())


@app.route("/")
def home():
    conn = db()

    groups = conn.execute("SELECT COUNT(*) FROM groups").fetchone()[0]
    planned = conn.execute(
        "SELECT COUNT(*) FROM posts WHERE status='planned'"
    ).fetchone()[0]
    sent = conn.execute(
        "SELECT COUNT(*) FROM posts WHERE status='sent'"
    ).fetchone()[0]

    conn.close()

    page = """
    {% extends "base" %}
    {% block content %}
    <h1>AFF Yönetim Paneli</h1>
    <p>Telegram paylaşım sistemine hoş geldin.</p>

    <div class="card">
        Telegram Grupları
        <div class="number">{{groups}}</div>
    </div>

    <div class="card">
        Planlanan Postlar
        <div class="number">{{planned}}</div>
    </div>

    <div class="card">
        Gönderilenler
        <div class="number">{{sent}}</div>
    </div>

    <br><br>
    <a class="btn" href="/new">➕ Yeni Post Oluştur</a>
    {% endblock %}
    """

    return render_template_string(
        HTML.replace("{% block content %}", "").replace("{% endblock %}", ""),
        groups=groups,
        planned=planned,
        sent=sent
    )


@app.route("/groups", methods=["GET", "POST"])
def groups_page():

    message = ""

    if request.method == "POST":
        name = request.form["name"]
        chat_id = request.form["chat_id"]

        try:
            conn = db()
            conn.execute(
                "INSERT OR REPLACE INTO groups(chat_id,title) VALUES (?,?)",
                (chat_id, name)
            )
            conn.commit()
            conn.close()
            message = "Grup başarıyla eklendi."
        except Exception as e:
            message = f"Hata: {e}"

    conn = db()
    groups = conn.execute("SELECT * FROM groups ORDER BY chat_id DESC").fetchall()
    conn.close()

    HTML = HTML.replace("{% block content %}", "").replace("{% endblock %}", "")
    return render_template_string('\n' + HTML,
        groups=groups,
        message=message,
        extra=""
    )

        {% if message %}
        <div class="ok">{{message}}</div>
        {% endif %}

        <div class="box">
        <h2>Yeni Grup Ekle</h2>

        <form method="post">
        <label>Grup adı</label>
        <input name="name" placeholder="Örn: Partner ABC" required>

        <label>Telegram Chat ID</label>
        <input name="chat_id" placeholder="-1001234567890" required>

        <button>Grubu Kaydet</button>
        </form>
        </div>

        <h2>Kayıtlı Gruplar</h2>

        <table>
        <tr><th>Grup</th><th>Chat ID</th></tr>
        {% for g in groups %}
        <tr>
        <td>{{g['title']}}</td>
        <td>{{g['chat_id']}}</td>
        </tr>
        {% endfor %}
        </table>
        """
    ).replace("</div>\n\n</body>", "</div>\n</body>")


@app.route("/new", methods=["GET", "POST"])
def new_post():

    conn = db()
    groups = conn.execute("SELECT * FROM groups").fetchall()
    conn.close()

    message = None
    error = None

    if request.method == "POST":
        group_id = request.form["group_id"]
        text = request.form["text"]
        send_at = request.form["send_at"]

        conn = db()
        conn.execute(
            """
            INSERT INTO posts(group_id,text,send_at,status)
            VALUES(?,?,?,'planned')
            """,
            (group_id, text, send_at)
        )
        conn.commit()
        conn.close()

        message = "Post planlandı."

    page = """
    <h1>➕ Yeni Post</h1>

    {% if message %}
    <div class="ok">{{message}}</div>
    {% endif %}

    <div class="box">
    <form method="post">

    <label>Telegram Grubu</label>

    <select name="group_id" required>
    <option value="">Grup seç</option>
    {% for g in groups %}
    <option value="{{g['id']}}">
        {{g['title']}}
    </option>
    {% endfor %}
    </select>

    <label>Post</label>

    <textarea name="text"
    placeholder="Gönderilecek mesajı buraya yaz..."
    required></textarea>

    <label>Gönderim zamanı</label>

    <input type="datetime-local"
           name="send_at"
           required>

    <button>📅 Postu Planla</button>

    </form>
    </div>
    """

    return render_template_string(
        HTML.replace("{% block content %}", "").replace("{% endblock %}", page),
        groups=groups,
        message=message
    )


@app.route("/planned")
def planned():

    conn = db()

    posts = conn.execute("""
    SELECT posts.*, groups.name
    FROM posts
    JOIN groups ON groups.id = posts.group_id
    WHERE posts.status='planned'
    ORDER BY posts.send_at
    """).fetchall()

    conn.close()

    page = """
    <h1>📅 Planlananlar</h1>

    <table>
    <tr>
    <th>Grup</th>
    <th>Post</th>
    <th>Zaman</th>
    </tr>

    {% for p in posts %}
    <tr>
    <td>{{p['title']}}</td>
    <td>{{p['text'][:100]}}</td>
    <td>{{p['send_at']}}</td>
    </tr>
    {% endfor %}
    </table>
    """

    return render_template_string(
        HTML.replace("{% block content %}", "").replace("{% endblock %}", page),
        posts=posts
    )


@app.route("/sent")
def sent():

    conn = db()

    posts = conn.execute("""
    SELECT posts.*, groups.name
    FROM posts
    JOIN groups ON groups.id = posts.group_id
    WHERE posts.status='sent'
    ORDER BY posts.sent_at DESC
    """).fetchall()

    conn.close()

    page = """
    <h1>📤 Gönderilenler</h1>

    <table>
    <tr>
    <th>Grup</th>
    <th>Post</th>
    <th>Gönderildi</th>
    </tr>

    {% for p in posts %}
    <tr>
    <td>{{p['title']}}</td>
    <td>{{p['text'][:100]}}</td>
    <td>{{p['sent_at']}}</td>
    </tr>
    {% endfor %}
    </table>
    """

    return render_template_string(
        HTML.replace("{% block content %}", "").replace("{% endblock %}", page),
        posts=posts
    )


@app.route("/settings")
def settings():
    page = """
    <h1>⚙️ Ayarlar</h1>

    <div class="box">
    <h3>Telegram Bot</h3>

    {% if token %}
    <div class="ok">Bot tokenı ayarlanmış.</div>
    {% else %}
    <div class="err">
    Bot tokenı henüz ayarlanmamış.
    </div>
    {% endif %}

    <p>Saat dilimi: Europe/Istanbul</p>
    </div>
    """

    return render_template_string(
        HTML.replace("{% block content %}", "").replace("{% endblock %}", page),
        token=bool(TOKEN)
    )


init_db()

if __name__ == "__main__":
    app.run(
        host="127.0.0.1",
        port=5001,
        debug=True
    )